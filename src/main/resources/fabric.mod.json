{
  "schemaVersion": 1,
  "id": "bossbarhider",
  "version": "${version}",
  "name": "BossBar Hider",
  "description": "A client-side mod that allows you to automatically hide boss bars based on a configurable list of titles. Keep your HUD clean and free from unwanted boss health bars on servers.",
  "authors": ["Jo_field"],
  "contact": {},
  "license": "GNU GENERAL PUBLIC LICENSE - Version 3",
  "environment": "client",
  "entrypoints": {
    "client": [
      "de.jo_field.bossbarhider.BossBarHiderClient"
    ],
    "modmenu": [
      "de.jo_field.bossbarhider.modmenu.BossbarHiderModMenuIntegration"
    ]
  },
  "mixins": [
    "bossbarhider.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "cloth-config": "*"
  },
  "recommends": {
    "modmenu": "*"
  }
}